# Copy to .env (next to docker-compose.yml) to override defaults. Never commit .env.
# Free Groq API key (console.groq.com -> API Keys). Used by the AI Assistant and invoice reading.
# Leave empty to run all AI in mock mode (scripted / fixture responses).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_PRIMARY_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_VISION_MODEL=qwen/qwen3.8-27b
