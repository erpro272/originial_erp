# Settings for running the API on the host (`make api`). All have dev defaults.
ERP_ENV=dev
ERP_DATABASE_URL=postgresql+asyncpg://erp_app:erp_app@localhost:5432/erp
ERP_DATABASE_OWNER_URL=postgresql+asyncpg://erp_owner:erp_owner@localhost:5432/erp
ERP_REDIS_URL=redis://localhost:6379/0
ERP_S3_ENDPOINT_URL=http://localhost:9000
# Production MUST set these (the app refuses to start with the dev defaults when ERP_ENV=prod):
# ERP_JWT_SECRET=<64 random bytes>
# ERP_MASTER_KEY=<base64 of 32 random bytes>   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ERP_S3_SECRET_KEY=...
# ERP_COOKIE_SECURE=true
# Free Groq API key (console.groq.com -> API Keys); empty = mock AI.
LLM_API_KEY=
